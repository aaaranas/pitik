# Pitik environment
#
# Every variable here is OPTIONAL. With no .env.local at all, Pitik runs as a
# fully-functional local-only camera: shooting, filters, the photobooth, rolls,
# favourites, export, sharing, and offline support all work. What you lose is
# accounts, backup, and shared rolls — the three things that genuinely need a
# server.
#
# Copy to .env.local and fill in to enable those:
#   cp .env.example .env.local

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The project's anon/publishable key.
#
# This one is safe in the browser bundle by design — it identifies the project,
# not a user, and every table is protected by Row Level Security (see
# supabase/migrations/0001_init.sql). Never put the service_role key here or
# anywhere else in this repository: it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
